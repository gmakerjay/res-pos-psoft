<Window x:Class="RestaurantPOS.KeyGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Psoft-RES - Developer License Generator (Private Tool)" 
        Height="580" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="#ECE9D8"
        FontFamily="Segoe UI, Tahoma">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" Padding="16,12" Margin="0,0,0,12" CornerRadius="4" BorderBrush="#F59E0B" BorderThickness="1.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="[ PSOFT RESTAURANT POS - DEVELOPER KEYGEN ]" 
                               FontWeight="Bold" FontSize="15" Foreground="#F59E0B"/>
                    <TextBlock Text="เครื่องมือสร้าง Activation Key ผูกติดฮาร์ดแวร์ประจำเครื่อง (ใช้สำหรับผู้พัฒนาเท่านั้น ห้ามส่งต่อให้ลูกค้า)" 
                               FontSize="11.5" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1E293B" Padding="8,4" CornerRadius="4" VerticalAlignment="Center">
                    <TextBlock Text="[ RSA-2048 SECURE ]" FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Form -->
        <Border Grid.Row="1" Background="White" BorderBrush="#7F9DB9" BorderThickness="1" Padding="18" CornerRadius="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Machine Code Input -->
                    <TextBlock Text="1. รหัสประจำเครื่องของลูกค้า (Customer Machine Code):" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtMachineCode" Grid.Column="0"
                                 FontFamily="Consolas, monospace" FontSize="14" FontWeight="Bold"
                                 Foreground="#0D47A1" Background="#FFFDE7" BorderBrush="#7F9DB9"
                                 Padding="8,5" CharacterCasing="Upper"/>
                        <Button x:Name="BtnPasteMachineCode" Grid.Column="1" Content="[ วางรหัส ]"
                                Width="85" Height="30" Margin="6,0,0,0"
                                Background="#ECE9D8" BorderBrush="#7F9DB9"
                                Click="BtnPasteMachineCode_Click"/>
                        <Button x:Name="BtnDetectThisPc" Grid.Column="2" Content="[ ดึงรหัสเครื่องนี้ ]"
                                Width="110" Height="30" Margin="6,0,0,0"
                                Background="#ECE9D8" BorderBrush="#7F9DB9"
                                Click="BtnDetectThisPc_Click"/>
                    </Grid>
                    <TextBlock Text="* ตัวอย่าง: RPOS-8F2B-9C1A-4D2E-7B90 (ดึงมาจากหน้าต่างเปิดใช้งานของโปรแกรมหน้าร้าน)" 
                               FontSize="11" Foreground="#64748B" Margin="0,0,0,14"/>

                    <!-- Store Code Input -->
                    <TextBlock Text="2. รหัสร้านค้า (Store Code):" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtStoreCode" Text="DEFAULT"
                             FontFamily="Consolas, monospace" FontSize="13" FontWeight="Bold"
                             Foreground="#333" Background="#FFFFFF" BorderBrush="#7F9DB9"
                             Padding="8,5" CharacterCasing="Upper" Margin="0,0,0,14"/>

                    <!-- License Plan Selection -->
                    <TextBlock Text="3. ประเภทสิทธิ์การใช้งาน (License Plan):" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,8"/>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,14" CornerRadius="4">
                        <StackPanel>
                            <RadioButton x:Name="RbLifetime" Content="สิทธิ์ตลอดชีพ (Full Lifetime - ไม่จำกัดเวลา / ปลดล็อกถาวร)" 
                                         IsChecked="True" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,8"/>
                            <RadioButton x:Name="RbYearly" Content="สิทธิ์รายปี (Full Yearly - 365 วัน)" 
                                         FontWeight="Bold" Foreground="#0369A1" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="RbCustomDays" Content="กำหนดจำนวนวันเอง:" 
                                             FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCustomDays" Text="30" Width="60" Height="26"
                                         FontFamily="Consolas, monospace" FontWeight="Bold"
                                         Padding="4,2" Margin="10,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="วัน" VerticalAlignment="Center" Foreground="#555"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Generate Button -->
                    <Button x:Name="BtnGenerateKey" Content="[ สร้างรหัสเปิดใช้งาน (Generate Activation Key) ]"
                            Height="38" FontSize="13.5" FontWeight="Bold" Foreground="White"
                            Background="#1E40AF" BorderBrush="#1D4ED8" Margin="0,0,0,14"
                            Click="BtnGenerateKey_Click"/>

                    <!-- Generated Key Output -->
                    <TextBlock Text="4. รหัสเปิดใช้งานที่สร้างได้ (Generated Key):" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtOutputKey" Height="80" TextWrapping="Wrap"
                             FontFamily="Consolas, monospace" FontSize="11.5"
                             Foreground="#0F172A" Background="#F1F5F9" BorderBrush="#94A3B8"
                             Padding="8" IsReadOnly="True" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                        <Button x:Name="BtnSaveLicFile" Content="[ บันทึกไฟล์ license.lic ]"
                                Width="160" Height="30" Margin="0,0,8,0"
                                Background="#ECE9D8" BorderBrush="#7F9DB9"
                                Click="BtnSaveLicFile_Click"/>
                        <Button x:Name="BtnCopyKey" Content="[ คัดลอก Activation Key ]"
                                Width="180" Height="30" FontWeight="Bold" Foreground="White"
                                Background="#15803D" BorderBrush="#166534"
                                Click="BtnCopyKey_Click"/>
                    </StackPanel>

                    <!-- Status Notification -->
                    <TextBlock x:Name="TxtStatus" Text="" FontWeight="Bold" FontSize="12" Foreground="#15803D" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="RestaurantPOS Licensing Architecture v1.0 | Offline Cryptographic Verification" 
                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                <Button x:Name="BtnClose" Content="[ ปิดโปรแกรม ]" HorizontalAlignment="Right"
                        Width="100" Height="28" Background="#ECE9D8" BorderBrush="#7F9DB9"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
