<Window x:Class="RestaurantPOS.Wpf.Views.ServerConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ตั้งค่าการเชื่อมต่อเซิร์ฟเวอร์ (Server Connection Setup)" 
        Height="410" Width="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#ECE9D8"
        FontFamily="Segoe UI, Tahoma">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#316AC5" Padding="14,10" Margin="0,0,0,12" CornerRadius="3">
            <StackPanel>
                <TextBlock Text="เชื่อมต่อโปรแกรมกับร้านค้าของคุณ (Store Connection)" 
                           FontWeight="Bold" FontSize="13.5" Foreground="White"/>
                <TextBlock Text="กรอกรหัสร้านค้าที่คุณได้รับจากการลงทะเบียนบนเว็บไซต์ เพื่อเริ่มขายหน้าร้านได้ทันที" 
                           FontSize="11" Foreground="#E0EDFF" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Form -->
        <Border Grid.Row="1" Background="White" BorderBrush="#7F9DB9" BorderThickness="1" Padding="14">
            <StackPanel VerticalAlignment="Center">
                
                <!-- Store Code (Prominent at top) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="รหัสร้านค้า (Store Code): *" FontWeight="Bold" FontSize="12" Foreground="#0D47A1"/>
                        <TextBlock Text="รหัสที่ได้จากการลงทะเบียน" FontSize="9.5" Foreground="#666666"/>
                    </StackPanel>
                    <TextBox x:Name="TxtStoreCode" Grid.Column="1" Height="32" VerticalContentAlignment="Center" 
                             Padding="8,2" FontSize="14" FontFamily="Consolas" FontWeight="Bold" Foreground="#1565C0"
                             BorderBrush="#1976D2" Background="#F0F7FF"
                             Text="DEFAULT"/>
                </Grid>

                <!-- Station Name -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ชื่อเครื่องหน้าร้าน:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11.5"/>
                    <TextBox x:Name="TxtStationName" Grid.Column="1" Height="28" VerticalContentAlignment="Center" 
                             Padding="6,2" FontSize="12" BorderBrush="#7F9DB9"
                             Text="POS-01"/>
                </Grid>

                <!-- Server URL / Address -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="เซิร์ฟเวอร์กลาง (Cloud):" FontWeight="SemiBold" FontSize="11.5"/>
                        <TextBlock Text="คลาวด์เชื่อมต่ออัตโนมัติ" FontSize="9.5" Foreground="#888888"/>
                    </StackPanel>
                    <TextBox x:Name="TxtServerAddress" Grid.Column="1" Height="28" VerticalContentAlignment="Center" 
                             Padding="6,2" FontSize="11.5" FontFamily="Consolas" BorderBrush="#7F9DB9"
                             Text="https://spk.p-services.net"/>
                </Grid>

                <!-- Test Connection Row -->
                <DockPanel Margin="0,4,0,0">
                    <Button x:Name="BtnTest" Content="ทดสอบการเชื่อมต่อ (Test Connection)" 
                            Height="28" Padding="12,2" Background="#F0F0F0" BorderBrush="#7F9DB9"
                            FontWeight="SemiBold" Click="BtnTest_Click"/>
                    <TextBlock x:Name="TxtStatus" Text="ยังไม่ได้ทดสอบ" VerticalAlignment="Center" 
                               Margin="12,0,0,0" FontSize="11" Foreground="#666666"/>
                </DockPanel>

            </StackPanel>
        </Border>

        <!-- Bottom Action Buttons -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="ใช้ค่าเครื่องนี้ (Localhost)" Height="26" Padding="8,2"
                    Background="#F0F0F0" BorderBrush="#7F9DB9" FontSize="11"
                    Click="BtnSetLocalhost_Click"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="ยกเลิก (Cancel)" Width="85" Height="26" Margin="0,0,8,0"
                        Background="#F0F0F0" BorderBrush="#7F9DB9"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave" Content="บันทึกและเชื่อมต่อ (Save &amp; Connect)" Height="26" Padding="14,2"
                        Background="#245EDC" Foreground="White" BorderBrush="#1C4BB3" FontWeight="Bold"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
