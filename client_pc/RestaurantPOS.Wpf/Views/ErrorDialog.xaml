<Window x:Class="RestaurantPOS.Wpf.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ข้อผิดพลาดของระบบ (System Error)" 
        Height="280" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#ECE9D8"
        FontFamily="Segoe UI, Tahoma">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Classic Stop Icon -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Border Width="36" Height="36" CornerRadius="18" Background="#D32F2F" Margin="0,0,15,0">
                <TextBlock Text="X" Foreground="White" FontWeight="Bold" FontSize="20" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="เกิดข้อผิดพลาดในการทำงาน" FontWeight="Bold" FontSize="14" Foreground="#333333"/>
                <TextBlock x:Name="TxtTitle" Text="ไม่สามารถดำเนินการตามคำขอได้" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Message Body -->
        <Border Grid.Row="1" Background="White" BorderBrush="#7F9DB9" BorderThickness="1" Padding="10" Margin="0,0,0,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtMessage" Text="รายละเอียดข้อความข้อผิดพลาด" TextWrapping="Wrap" FontSize="12" Foreground="#222222"/>
                    <TextBlock x:Name="TxtDetails" Text="" TextWrapping="Wrap" FontSize="10" FontFamily="Consolas" Foreground="#666666" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <DockPanel Grid.Row="2">
            <Button x:Name="BtnToggleDetails" Content="ดูรายละเอียด..." Width="100" Height="26" 
                    Background="#F0F0F0" BorderBrush="#7F9DB9" Click="BtnToggleDetails_Click"/>
            <Button Content="ตกลง (OK)" Width="90" Height="26" HorizontalAlignment="Right"
                    Background="#E1E1E1" BorderBrush="#7F9DB9" FontWeight="Bold" IsDefault="True"
                    Click="BtnOk_Click"/>
        </DockPanel>
    </Grid>
</Window>
