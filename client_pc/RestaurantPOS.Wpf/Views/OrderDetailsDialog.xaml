<Window x:Class="RestaurantPOS.Wpf.Views.OrderDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="รายละเอียดคำสั่งซื้อ (Order Details)" Height="660" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI, Tahoma, sans-serif" FontSize="14.5"
        Background="#ECE9D8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/> <!-- Header Bar -->
            <RowDefinition Height="*"/>  <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
        </Grid.RowDefinitions>

        <!-- 1. Header Bar Classic Style -->
        <Border Grid.Row="0" Background="#1E3A8A" Padding="14,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtHeaderTitle" Text="รายละเอียดคำสั่งซื้อ: ORD-XXXXXXXX" 
                           FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHeaderStatus" Text="[สถานะ]" FontWeight="Bold" FontSize="14" 
                           Foreground="#FDE047" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 2. Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
            <StackPanel>
                <!-- Order & Customer Info Card -->
                <Border Background="White" BorderBrush="#7F9DB9" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Order Info -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="เลขที่บิล:" FontWeight="SemiBold" Foreground="#64748B" Width="100"/>
                                <TextBlock x:Name="TxtOrderNumber" Text="ORD-20261007-0001" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="โต๊ะ/ประเภท:" FontWeight="SemiBold" Foreground="#64748B" Width="100"/>
                                <TextBlock x:Name="TxtTableInfo" Text="โต๊ะ 1" FontWeight="Bold" FontSize="15" Foreground="#1D4ED8"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="เวลาที่สั่ง:" FontWeight="SemiBold" Foreground="#64748B" Width="100"/>
                                <TextBlock x:Name="TxtOrderTime" Text="07/10/2026 11:00:00" FontWeight="SemiBold" Foreground="#334155"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="สถานะออเดอร์:" FontWeight="SemiBold" Foreground="#64748B" Width="100"/>
                                <TextBlock x:Name="TxtOrderStatus" Text="[ออเดอร์ใหม่]" FontWeight="Bold" Foreground="#B91C1C"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- Right: Customer & Phone Info (Highlight for Verification) -->
                        <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="4" Padding="10">
                            <StackPanel>
                                <TextBlock Text="ข้อมูลติดต่อลูกค้า (สำหรับโทรยืนยันคำสั่งซื้อ)" FontWeight="Bold" FontSize="13" Foreground="#1E40AF" Margin="0,0,0,6"/>
                                
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="ชื่อลูกค้า:" FontWeight="SemiBold" Foreground="#475569" Width="85"/>
                                    <TextBlock x:Name="TxtCustomerName" Text="ลูกค้าทั่วไป" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                </DockPanel>

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="เบอร์โทรศัพท์:" FontWeight="SemiBold" Foreground="#475569" Width="85" VerticalAlignment="Center"/>
                                    <Border Background="#DBEAFE" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock x:Name="TxtCustomerPhone" Text="081-234-5678" FontWeight="Bold" FontSize="16" Foreground="#1D4ED8"/>
                                    </Border>
                                </DockPanel>

                                <TextBlock Text="* โทรสอบถามหรือคอนเฟิร์มออเดอร์ตามเบอร์นี้เพื่อป้องกันการสั่งเล่น" 
                                           FontSize="11.5" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Customer Order Notes (Highlighted Banner) -->
                <Border x:Name="PanelOrderNotes" Background="#FEF9C3" BorderBrush="#EAB308" BorderThickness="1.5" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="หมายเหตุคำสั่งซื้อจากลูกค้า (Customer Order Notes):" FontWeight="Bold" FontSize="13.5" Foreground="#854D0E" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtOrderNotes" Text="เผ็ดน้อย ไม่ใส่ถั่วงอก ขอช้อนส้อม 2 ชุด" FontSize="15" FontWeight="Bold" Foreground="#713F12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Order Items Grid -->
                <Border Background="White" BorderBrush="#7F9DB9" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="รายการอาหารที่สั่ง (Ordered Items)" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,8"/>

                        <DataGrid x:Name="GridOrderItems" AutoGenerateColumns="False" CanUserAddRows="False"
                                  BorderBrush="#DCDCDC" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  FontSize="14" RowHeight="42" IsReadOnly="True" MaxHeight="240">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="รายการอาหาร" Binding="{Binding ProductName}" Width="*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="รายละเอียด / หมายเหตุพิเศษ" Binding="{Binding OptionsAndNotesDisplay}" Width="250" Foreground="#DC2626" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="ราคา/หน่วย" Binding="{Binding UnitPrice, StringFormat='{}{0:N2}'}" Width="95"/>
                                <DataGridTextColumn Header="จำนวน" Binding="{Binding Quantity, StringFormat='{}x {0}'}" Width="75" FontWeight="Bold"/>
                                <DataGridTextColumn Header="รวม (บาท)" Binding="{Binding Subtotal, StringFormat='{}{0:N2}'}" Width="105" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Total Amount Summary Card -->
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="ยอดรวมสุทธิทั้งสิ้น:" FontWeight="Bold" FontSize="16" Foreground="#475569" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotalAmount" Text="0.00 บาท" FontWeight="Bold" FontSize="24" Foreground="#15803D" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Bottom Action Bar -->
        <Border Grid.Row="2" Background="#D8D4C8" BorderBrush="#9E9A8E" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnAcceptOrder" Content="รับออเดอร์" Height="38" Padding="16,0" Margin="0,0,8,0"
                        Background="#1D4ED8" Foreground="White" BorderBrush="#1E40AF" FontWeight="Bold" FontSize="14"
                        Click="BtnAcceptOrder_Click" Cursor="Hand"/>
                <Button x:Name="BtnReadyOrder" Content="ปรุงเสร็จแล้ว" Height="38" Padding="16,0" Margin="0,0,8,0"
                        Background="#EA580C" Foreground="White" BorderBrush="#C2410C" FontWeight="Bold" FontSize="14"
                        Click="BtnReadyOrder_Click" Cursor="Hand"/>
                <Button x:Name="BtnPrintKitchen" Content="พิมพ์สลิปครัว" Height="38" Padding="16,0" Margin="0,0,8,0"
                        Background="#F1F5F9" Foreground="#1E293B" BorderBrush="#CBD5E1" FontWeight="SemiBold" FontSize="14"
                        Click="BtnPrintKitchen_Click" Cursor="Hand"/>
                
                <Button Content="ปิดหน้าต่าง" Height="38" Padding="20,0" DockPanel.Dock="Right"
                        Background="#E2E8F0" Foreground="#1E293B" BorderBrush="#94A3B8" FontWeight="SemiBold" FontSize="14"
                        Click="BtnClose_Click" Cursor="Hand"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
