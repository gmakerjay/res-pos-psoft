<Window x:Class="RestaurantPOS.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เข้าสู่ระบบ Restaurant POS (User Login)" 
        Height="320" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#ECE9D8"
        FontFamily="Segoe UI, Tahoma">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#316AC5" Padding="12,10" Margin="0,0,0,12" CornerRadius="2">
            <StackPanel>
                <TextBlock Text="[เข้าสู่ระบบ] Restaurant POS System" 
                           FontWeight="Bold" FontSize="13" Foreground="White"/>
                <TextBlock x:Name="TxtLoginSubtitle" Text="กรอกชื่อผู้ใช้และรหัสผ่านเพื่อเข้าใช้งานโปรแกรมหน้าร้าน" 
                           FontSize="10.5" Foreground="#E0EDFF" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Form -->
        <Border Grid.Row="1" Background="White" BorderBrush="#7F9DB9" BorderThickness="1" Padding="16">
            <StackPanel VerticalAlignment="Center">
                
                <!-- Username -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ชื่อผู้ใช้:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox x:Name="TxtUsername" Grid.Column="1" Height="28" VerticalContentAlignment="Center" 
                             Padding="6,2" FontSize="12" BorderBrush="#7F9DB9"/>
                </Grid>

                <!-- Password -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="รหัสผ่าน:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                    <PasswordBox x:Name="TxtPassword" Grid.Column="1" Height="28" VerticalContentAlignment="Center" 
                                 Padding="6,2" FontSize="12" BorderBrush="#7F9DB9"/>
                </Grid>

                <!-- Error Message -->
                <TextBlock x:Name="TxtError" Text="" Foreground="#C62828" FontSize="11" 
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="100,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Bottom Action Buttons -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="BtnConfig" Content="ตั้งค่าเซิร์ฟเวอร์" Height="28" Padding="10,2"
                    Background="#F0F0F0" BorderBrush="#7F9DB9" FontSize="11"
                    Click="BtnConfig_Click"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnExit" Content="ปิดโปรแกรม" Width="85" Height="28" Margin="0,0,8,0"
                        Background="#F0F0F0" BorderBrush="#7F9DB9" IsCancel="True"
                        Click="BtnExit_Click"/>
                <Button x:Name="BtnLogin" Content="เข้าสู่ระบบ (Login)" Height="28" Padding="16,2"
                        Background="#245EDC" Foreground="White" BorderBrush="#1C4BB3" FontWeight="Bold"
                        IsDefault="True" Click="BtnLogin_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
