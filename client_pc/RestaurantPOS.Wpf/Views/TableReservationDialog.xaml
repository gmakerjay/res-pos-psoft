<Window x:Class="RestaurantPOS.Wpf.Views.TableReservationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ระบบผังโต๊ะอาหารและการจัดการจองโต๊ะล่วงหน้า (Table Floor &amp; Reservation Manager)" 
        Height="680" Width="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#ECE9D8"
        FontFamily="Segoe UI, Tahoma">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Banner -->
        <Border Grid.Row="0" Background="#1E3A8A" Padding="14,10" Margin="0,0,0,10" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="[ ผังโต๊ะอาหาร &amp; จัดการระบบจองโต๊ะล่วงหน้า ]" 
                               FontWeight="Bold" FontSize="15" Foreground="White"/>
                    <TextBlock Text="สถานะโต๊ะสด: สีปกติ (ว่าง) | สีแดง (ทำงานอยู่/มีลูกค้า) | สีเหลือง (จองแล้ว)" 
                               FontSize="11.5" Foreground="#BFDBFE" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Status Badges Summary & Refresh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                        <TextBlock x:Name="TxtCountAvailable" Text="[ว่าง: 0]" FontWeight="Bold" FontSize="12" Foreground="#334155"/>
                    </Border>
                    <Border Background="#FEF08A" BorderBrush="#EAB308" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                        <TextBlock x:Name="TxtCountReserved" Text="[จองแล้ว: 0]" FontWeight="Bold" FontSize="12" Foreground="#854D0E"/>
                    </Border>
                    <Border Background="#FEE2E2" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtCountOccupied" Text="[ทำงานอยู่: 0]" FontWeight="Bold" FontSize="12" Foreground="#991B1B"/>
                    </Border>
                    <Button x:Name="BtnRefresh" Content="[ รีเฟรชผังโต๊ะ ]" 
                            Padding="12,5" FontWeight="Bold" FontSize="12"
                            Background="#2563EB" Foreground="White" BorderBrush="#1D4ED8"
                            Click="BtnRefresh_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: 2 Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Table Floor Grid Cards -->
            <Border Grid.Column="0" Background="White" BorderBrush="#7F9DB9" BorderThickness="1" CornerRadius="2" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Filter Bar -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="ผังโต๊ะอาหารทั้งหมด" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton x:Name="RbFilterAll" Content="ทั้งหมด" IsChecked="True" Margin="0,0,10,0" Checked="Filter_Checked"/>
                            <RadioButton x:Name="RbFilterAvailable" Content="ว่าง (สีปกติ)" Margin="0,0,10,0" Checked="Filter_Checked"/>
                            <RadioButton x:Name="RbFilterReserved" Content="จองแล้ว (สีเหลือง)" Margin="0,0,10,0" Checked="Filter_Checked"/>
                            <RadioButton x:Name="RbFilterOccupied" Content="ทำงานอยู่ (สีแดง)" Checked="Filter_Checked"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Cards ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="PanelTableCards" ItemWidth="140" ItemHeight="115" Margin="0,0,0,10"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Table Action & Reservation Details Panel -->
            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#7F9DB9" BorderThickness="1" CornerRadius="2" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header of Selected Table -->
                    <Border Grid.Row="0" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="TxtSelectedTableTitle" Text="กรุณาเลือกโต๊ะในผัง" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                <Border x:Name="BadgeSelectedStatus" HorizontalAlignment="Right" Padding="6,2" CornerRadius="3" Background="#CBD5E1">
                                    <TextBlock x:Name="TxtSelectedStatus" Text="[ไม่มีการเลือก]" FontWeight="Bold" FontSize="11" Foreground="#334155"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="TxtSelectedCapacity" Text="ความจุ: - ที่นั่ง" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Content Panel based on Table Status -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelActionContent">

                            <!-- Section 1: When table is Reserved (Yellow) -->
                            <StackPanel x:Name="PanelReservedDetails" Visibility="Collapsed">
                                <Border Background="#FEF08A" BorderBrush="#EAB308" BorderThickness="1.5" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="[ ข้อมูลการจองโต๊ะ ]" FontWeight="Bold" FontSize="13" Foreground="#854D0E" Margin="0,0,0,8"/>
                                        
                                        <TextBlock Text="ชื่อผู้จอง:" FontSize="11.5" Foreground="#713F12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtDetailCustName" Text="-" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>

                                        <TextBlock Text="เบอร์โทรศัพท์:" FontSize="11.5" Foreground="#713F12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtDetailCustPhone" Text="-" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>

                                        <TextBlock Text="วันและเวลาที่จอง:" FontSize="11.5" Foreground="#713F12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtDetailResTime" Text="-" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>

                                        <TextBlock Text="จำนวนที่นั่ง:" FontSize="11.5" Foreground="#713F12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtDetailPartySize" Text="-" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>

                                        <TextBlock Text="หมายเหตุ:" FontSize="11.5" Foreground="#713F12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtDetailNotes" Text="-" FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="BtnCheckInReserved" Content="[ เช็คอินเข้าโต๊ะ (เริ่มสั่งอาหาร) ]" 
                                        Height="38" Margin="0,0,0,8" FontWeight="Bold" FontSize="13"
                                        Background="#16A34A" Foreground="White" BorderBrush="#15803D"
                                        Click="BtnCheckInReserved_Click" Cursor="Hand"/>

                                <Button x:Name="BtnCancelReservation" Content="[ ยกเลิกการจองโต๊ะนี้ ]" 
                                        Height="32" Margin="0,0,0,8" FontWeight="SemiBold" FontSize="12"
                                        Background="#FEE2E2" Foreground="#991B1B" BorderBrush="#FCA5A5"
                                        Click="BtnCancelReservation_Click" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Section 2: When table is Available (Normal) -> Reservation Form -->
                            <StackPanel x:Name="PanelNewReservationForm" Visibility="Collapsed">
                                <TextBlock Text="[ บันทึกการจองโต๊ะใหม่ ]" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A" Margin="0,0,0,8"/>

                                <TextBlock Text="ชื่อลูกค้าผู้จอง *:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtInputCustName" Height="30" FontSize="13" Padding="6,2" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                                <TextBlock Text="เบอร์โทรศัพท์ติดต่อ *:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtInputCustPhone" Height="30" FontSize="13" Padding="6,2" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                                <TextBlock Text="เวลาที่ต้องการจอง (HH:mm) เช่น 18:30 *:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtInputResTime" Height="30" FontSize="13" Padding="6,2" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                                <TextBlock Text="จำนวนลูกค้า (ท่าน):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtInputPartySize" Text="4" Height="30" FontSize="13" Padding="6,2" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                                <TextBlock Text="หมายเหตุ / คำขอพิเศษ:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtInputNotes" Height="48" FontSize="12" Padding="6,4" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>

                                <Button x:Name="BtnSaveReservation" Content="[ + บันทึกการจองโต๊ะ (สีเหลือง) ]" 
                                        Height="38" Margin="0,0,0,8" FontWeight="Bold" FontSize="13"
                                        Background="#D97706" Foreground="White" BorderBrush="#B45309"
                                        Click="BtnSaveReservation_Click" Cursor="Hand"/>

                                <Button x:Name="BtnDirectOccupy" Content="[ เปิดโต๊ะมีลูกค้านั่งทันที (สีแดง) ]" 
                                        Height="32" Margin="0,0,0,8" FontWeight="SemiBold" FontSize="12"
                                        Background="#DC2626" Foreground="White" BorderBrush="#B91C1C"
                                        Click="BtnDirectOccupy_Click" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Section 3: When table is Occupied (Red) -->
                            <StackPanel x:Name="PanelOccupiedDetails" Visibility="Collapsed">
                                <Border Background="#FEE2E2" BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="[ โต๊ะทำงานอยู่ / มีลูกค้า ]" FontWeight="Bold" FontSize="13" Foreground="#991B1B" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtOccupiedBillInfo" Text="ยอดรวมบิลปัจจุบัน: 0.00 บ." FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtOccupiedTimeInfo" Text="นั่งเมื่อ: -" FontSize="11.5" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="BtnSelectTableInPos" Content="[ เลือกโต๊ะนี้เพื่อจัดการออเดอร์ใน POS ]" 
                                        Height="38" Margin="0,0,0,8" FontWeight="Bold" FontSize="13"
                                        Background="#1D4ED8" Foreground="White" BorderBrush="#1E40AF"
                                        Click="BtnSelectTableInPos_Click" Cursor="Hand"/>

                                <Button x:Name="BtnClearOccupiedTable" Content="[ สลับเป็นโต๊ะว่าง (เคลียร์โต๊ะ) ]" 
                                        Height="32" Margin="0,0,0,8" FontWeight="SemiBold" FontSize="12"
                                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1"
                                        Click="BtnClearOccupiedTable_Click" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Default Prompt when no table selected -->
                            <TextBlock x:Name="TxtNoTableSelectedNotice" Text="เลือกโต๊ะจากผังด้านซ้ายเพื่อดูรายละเอียด บันทึกการจอง หรือเช็คอินเข้าโต๊ะ" 
                                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="10,20,10,0" TextAlignment="Center"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Close Button -->
                    <Button Grid.Row="2" Content="ปิดหน้าต่าง (Close)" Height="34" FontWeight="Bold" FontSize="12.5"
                            Background="#E2E8F0" Foreground="#334155" BorderBrush="#CBD5E1"
                            Click="BtnClose_Click" Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Footer Info -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="10,6" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="ระบบซิงค์สถานะโต๊ะแบบ Real-Time อัตโนมัติร่วมกับ SignalR Hub, Web App และเครื่องแคชเชียร์ทุกจุด" 
                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Text="Restaurant POS Enterprise" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
