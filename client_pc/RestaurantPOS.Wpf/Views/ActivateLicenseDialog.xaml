<Window x:Class="RestaurantPOS.Wpf.Views.ActivateLicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เปิดใช้งานสิทธิ์ Restaurant POS (License Activation)" 
        Height="420" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#ECE9D8"
        FontFamily="Segoe UI, Tahoma">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#316AC5" Padding="14,10" Margin="0,0,0,12" CornerRadius="3">
            <StackPanel>
                <TextBlock Text="[ เปิดใช้งานสิทธิ์การใช้งาน Restaurant POS ]" 
                           FontWeight="Bold" FontSize="14" Foreground="White"/>
                <TextBlock Text="กรอกรหัสเปิดใช้งาน (Activation Key) ที่ได้รับจากผู้พัฒนาเพื่อปลดล็อกสิทธิ์" 
                           FontSize="11" Foreground="#E0EDFF" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Background="White" BorderBrush="#7F9DB9" BorderThickness="1" Padding="16" CornerRadius="2">
            <StackPanel>
                <!-- Current Store Info Group -->
                <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,0,0,14" CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ชื่อร้านอาหาร:" FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtStoreName" Grid.Row="0" Grid.Column="1" Text="ร้านอาหาร..." FontWeight="Bold" FontSize="12" Foreground="#333" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="รหัสร้าน (Store Code):" FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtStoreCode" Grid.Row="1" Grid.Column="1" Text="RPOS-..." FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="13" Foreground="#1565C0" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="สิทธิ์ปัจจุบัน:" FontSize="12" Foreground="#555"/>
                        <TextBlock x:Name="TxtCurrentPlan" Grid.Row="2" Grid.Column="1" Text="[ กำลังตรวจสอบ... ]" FontWeight="Bold" FontSize="12" Foreground="#E65100"/>
                    </Grid>
                </Border>

                <!-- Activation Key Input -->
                <TextBlock Text="รหัสเปิดใช้งาน (Activation Key):" FontWeight="Bold" FontSize="12.5" Foreground="#333" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtLicenseKey" 
                         FontFamily="Consolas, monospace" FontSize="16" FontWeight="Bold"
                         Foreground="#0D47A1" Background="#FFFDE7" BorderBrush="#7F9DB9"
                         Padding="10,6" CharacterCasing="Upper"
                         Margin="0,0,0,6"/>
                <TextBlock Text="* รูปแบบ: ACT-XXX-XXXX-XXXX (เช่น ACT-LFE-8K2N-9X4M)" 
                           FontSize="11" Foreground="#666" Margin="0,0,0,10"/>

                <!-- Status Message -->
                <TextBlock x:Name="TxtStatusMessage" 
                           Text="" FontWeight="Bold" FontSize="12" 
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="[ ปิดหน้าต่าง ]" 
                    Width="110" Height="30" Margin="0,0,8,0"
                    Background="#ECE9D8" BorderBrush="#7F9DB9"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnActivate" Content="[ ตรวจสอบ &amp; เปิดใช้งาน ]" 
                    Width="160" Height="30"
                    FontWeight="Bold" Foreground="White"
                    Background="#2E7D32" BorderBrush="#1B5E20"
                    Click="BtnActivate_Click"/>
        </StackPanel>
    </Grid>
</Window>
