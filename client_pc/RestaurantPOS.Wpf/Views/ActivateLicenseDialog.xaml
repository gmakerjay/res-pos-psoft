<Window x:Class="RestaurantPOS.Wpf.Views.ActivateLicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เปิดใช้งานสิทธิ์ Restaurant POS (License Activation)" 
        Height="540" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#ECE9D8"
        FontFamily="Segoe UI, Tahoma">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#316AC5" Padding="14,10" Margin="0,0,0,12" CornerRadius="3">
            <StackPanel>
                <TextBlock Text="[ เปิดใช้งานสิทธิ์การใช้งาน Restaurant POS ]" 
                           FontWeight="Bold" FontSize="14" Foreground="White"/>
                <TextBlock Text="ระบบตรวจสอบสิทธิ์ระดับฮาร์ดแวร์ (Hardware-Bound Cryptographic License)" 
                           FontSize="11" Foreground="#E0EDFF" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Background="White" BorderBrush="#7F9DB9" BorderThickness="1" Padding="16" CornerRadius="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Machine Code Section (For customer to send to Dev) -->
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12" Margin="0,0,0,12" CornerRadius="3">
                        <StackPanel>
                            <TextBlock Text="รหัสประจำเครื่องนี้ (Machine Code):" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtMachineCode" Grid.Column="0"
                                         FontFamily="Consolas, monospace" FontSize="14" FontWeight="Bold"
                                         Foreground="#0D47A1" Background="#FFFFFF" BorderBrush="#94A3B8"
                                         Padding="8,5" IsReadOnly="True" Margin="0,0,8,0"/>
                                <Button x:Name="BtnCopyMachineCode" Grid.Column="1" Content="[ คัดลอกรหัสเครื่อง ]"
                                        Width="140" Height="30" FontWeight="Bold"
                                        Background="#ECE9D8" BorderBrush="#7F9DB9"
                                        Click="BtnCopyMachineCode_Click"/>
                            </Grid>
                            <TextBlock Text="* กรุณาส่งรหัสประจำเครื่องนี้ให้ผู้พัฒนาเพื่อออกรหัสเปิดใช้งาน (Activation Key)" 
                                       FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <!-- Current License Info Group -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,14" CornerRadius="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="รหัสร้าน (Store Code):" FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtStoreCode" Grid.Row="0" Grid.Column="1" Text="DEFAULT" FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="13" Foreground="#1565C0" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="สถานะสิทธิ์ปัจจุบัน:" FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtCurrentPlan" Grid.Row="1" Grid.Column="1" Text="[ กำลังตรวจสอบ... ]" FontWeight="Bold" FontSize="12" Foreground="#E65100" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="รายละเอียดสิทธิ์:" FontSize="12" Foreground="#555"/>
                            <TextBlock x:Name="TxtPlanDetail" Grid.Row="2" Grid.Column="1" Text="..." FontSize="11.5" Foreground="#475569" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Activation Key Input -->
                    <TextBlock Text="รหัสเปิดใช้งาน (Activation Key):" FontWeight="Bold" FontSize="12.5" Foreground="#333" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtLicenseKey" Height="75" TextWrapping="Wrap"
                             FontFamily="Consolas, monospace" FontSize="11.5" FontWeight="Bold"
                             Foreground="#0D47A1" Background="#FFFDE7" BorderBrush="#7F9DB9"
                             Padding="8" Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                        <Button x:Name="BtnLoadLicFile" Content="[ โหลดไฟล์ .lic ]"
                                Width="120" Height="28" Margin="0,0,8,0"
                                Background="#ECE9D8" BorderBrush="#7F9DB9"
                                Click="BtnLoadLicFile_Click"/>
                        <Button x:Name="BtnPasteKey" Content="[ วางคีย์จากคลิปบอร์ด ]"
                                Width="150" Height="28"
                                Background="#ECE9D8" BorderBrush="#7F9DB9"
                                Click="BtnPasteKey_Click"/>
                    </StackPanel>

                    <!-- Status Message -->
                    <TextBlock x:Name="TxtStatusMessage" 
                               Text="" FontWeight="Bold" FontSize="12" 
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="[ ปิดหน้าต่าง ]" 
                    Width="110" Height="30" Margin="0,0,8,0"
                    Background="#ECE9D8" BorderBrush="#7F9DB9"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnActivate" Content="[ ตรวจสอบ &amp; เปิดใช้งาน ]" 
                    Width="170" Height="30"
                    FontWeight="Bold" Foreground="White"
                    Background="#2E7D32" BorderBrush="#1B5E20"
                    Click="BtnActivate_Click"/>
        </StackPanel>
    </Grid>
</Window>
