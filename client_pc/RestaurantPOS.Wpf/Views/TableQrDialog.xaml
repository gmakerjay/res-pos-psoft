<Window x:Class="RestaurantPOS.Wpf.Views.TableQrDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ระบบจัดการและพิมพ์ป้าย QR Code ประจำโต๊ะอาหาร (Table QR Manager)" 
        Height="580" Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#ECE9D8"
        FontFamily="Segoe UI, Tahoma">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#316AC5" Padding="14,10" Margin="0,0,0,10" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="[ ระบบจัดการและสั่งพิมพ์ป้าย QR Code ติดโต๊ะอาหาร ]" 
                               FontWeight="Bold" FontSize="14" Foreground="White"/>
                    <TextBlock x:Name="TxtStoreHeader" 
                               Text="เชื่อมต่อกับร้านค้าของคุณ — ลูกค้าสแกนสั่งอาหาร ข้อมูลจะวิ่งเข้าสู่ POS หน้าร้านทันที" 
                               FontSize="11" Foreground="#E0EDFF" Margin="0,3,0,0"/>
                </StackPanel>

                <Button x:Name="BtnOpenWebSheet" Grid.Column="1" 
                        Content="[ เปิดหน้าพิมพ์สติ๊กเกอร์ A4 บนเว็บ ]" 
                        Padding="12,6" FontWeight="Bold" FontSize="11.5"
                        Background="#2E7D32" Foreground="White" BorderBrush="#1B5E20"
                        Click="BtnOpenWebSheet_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Main Body: 2 Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Table List -->
            <Border Grid.Column="0" Background="White" BorderBrush="#7F9DB9" BorderThickness="1" CornerRadius="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,8">
                        <TextBlock Text="รายการโต๊ะอาหาร &amp; จุดสั่ง" FontWeight="Bold" FontSize="12" Foreground="#333"/>
                    </Border>

                    <ListBox x:Name="ListTables" Grid.Row="1" BorderThickness="0" 
                             SelectionChanged="ListTables_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TableNumber}" 
                                                   FontWeight="Bold" FontSize="13" Foreground="#0D47A1" 
                                                   Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" 
                                                   FontSize="12" Foreground="#333" 
                                                   VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Capacity, StringFormat='{}{0} ที่นั่ง'}" 
                                                   FontSize="11" Foreground="#777" 
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Add Table Bar -->
                    <Border Grid.Row="2" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNewTableNo" Grid.Column="0" Height="26" 
                                     VerticalContentAlignment="Center" Padding="4,0"
                                     FontSize="11.5" Margin="0,0,6,0"/>
                            <Button x:Name="BtnAddTable" Grid.Column="1" Content="+ เพิ่มโต๊ะ" 
                                    Padding="8,4" FontSize="11.5" FontWeight="Bold"
                                    Background="#316AC5" Foreground="White" BorderBrush="#204A87"
                                    Click="BtnAddTable_Click" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Column: QR Code Preview & Print Actions -->
            <Border Grid.Column="2" Background="White" BorderBrush="#7F9DB9" BorderThickness="1" CornerRadius="2" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selected Target Header -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="12,8" CornerRadius="3" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtSelectedTitle" Text="[ โต๊ะ: T01 ]" 
                                           FontWeight="Bold" FontSize="16" Foreground="#0D47A1"/>
                                <TextBlock x:Name="TxtSelectedSubtitle" Text="สแกนสั่งอาหารประจำโต๊ะนี้" 
                                           FontSize="11.5" Foreground="#555" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnDeleteTable" Grid.Column="1" Content="ลบโต๊ะนี้" 
                                    Padding="8,4" FontSize="11" Foreground="#C62828" Background="#FFEBEE" 
                                    BorderBrush="#FFCDD2" Click="BtnDeleteTable_Click" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Center QR Code Image Box -->
                    <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Background="#FAFAFA" 
                            CornerRadius="4" Padding="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Live QR Code Image -->
                            <Border Background="White" BorderBrush="#CCC" BorderThickness="1" 
                                    Padding="6" CornerRadius="4" HorizontalAlignment="Center">
                                <Image x:Name="ImgQrCode" Width="180" Height="180" Stretch="Uniform"/>
                            </Border>

                            <TextBlock Text="[ สแกนเพื่อดูเมนู &amp; สั่งอาหาร ]" 
                                       FontWeight="Bold" FontSize="12" Foreground="#2E7D32" 
                                       HorizontalAlignment="Center" Margin="0,10,0,2"/>
                            <TextBlock Text="ออเดอร์ส่งตรงเข้าห้องครัวและแคชเชียร์ทันที" 
                                       FontSize="10.5" Foreground="#666" HorizontalAlignment="Center"/>

                            <!-- QR URL String Display -->
                            <Border Background="#EEE" BorderBrush="#CCC" BorderThickness="1" 
                                    Padding="6,4" Margin="0,10,0,0" CornerRadius="3" MaxWidth="380">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtQrUrl" Grid.Column="0" IsReadOnly="True" 
                                             BorderThickness="0" Background="Transparent" 
                                             FontSize="10.5" FontFamily="Consolas" TextWrapping="NoWrap"/>
                                    <Button x:Name="BtnCopyUrl" Grid.Column="1" Content="คัดลอก" 
                                            Padding="6,2" FontSize="10" Margin="4,0,0,0" 
                                            Click="BtnCopyUrl_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Print Action Buttons -->
                    <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,10,0,0" BorderBrush="#EEE" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnPrintThermalSlip" 
                                    Content="[ สั่งพิมพ์สลิป QR โต๊ะ (80mm) ]" 
                                    Padding="16,8" FontWeight="Bold" FontSize="12.5"
                                    Background="#316AC5" Foreground="White" BorderBrush="#204A87"
                                    Click="BtnPrintThermalSlip_Click" Cursor="Hand" Margin="0,0,10,0"/>

                            <Button x:Name="BtnSaveQrPng" 
                                    Content="บันทึกรูปภาพ QR (PNG)" 
                                    Padding="14,8" FontSize="12"
                                    Background="#F5F5F5" Foreground="#333" BorderBrush="#BBB"
                                    Click="BtnSaveQrPng_Click" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Text="พร้อมใช้งาน" VerticalAlignment="Center" FontSize="11" Foreground="#444"/>
            <Button Grid.Column="1" Content="ปิดหน้าต่าง" Padding="16,6" FontSize="11.5" 
                    Background="#F0F0F0" BorderBrush="#999" Click="BtnClose_Click" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
